# ============================================================
# RedFlagAI — Environment Configuration TEMPLATE
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your key
# 3. Never commit .env to Git

# ── AI PROVIDER — pick ONE, comment out the others ───────────
# Option A: OpenRouter (recommended — 300+ models, one key)
# Get key free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Option B: Google Gemini
# Get key free at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your-gemini-api-key-here

# ── MODEL NAME ────────────────────────────────────────────────
# OpenRouter model options:
#   meta-llama/llama-3.3-70b-instruct     (fast, free tier)
#   mistralai/mistral-7b-instruct          (very fast, free tier)
#   google/gemini-2.0-flash-exp:free       (Gemini via OpenRouter, free)
#   openai/gpt-4o-mini                     (cheap, great quality)
#   anthropic/claude-3-haiku               (fast Claude)
#   deepseek/deepseek-chat                 (excellent, very cheap)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ── SERVER ───────────────────────────────────────────────────
PORT=8000
